
Host gitlab.com github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_main

Host aur.archlinux.org
    IdentityFile ~/.ssh/id_aur
    User ~/.ssh/id_aur

Host bastion.fedoraproject.org
  HostName bastion.fedoraproject.org
  User rapneset
  ProxyCommand none
  ForwardAgent no
Host *.rdu3.fedoraproject.org *.qa.fedoraproject.org 10.16.160.* 10.16.161.* 10.16.163.* 10.16.165.* 10.16.167.* 10.16.171.* *.vpn.fedoraproject.org
  ProxyJump bastion.fedoraproject.org
Host batcave01
  HostName %h.rdu3.fedoraproject.org

Host *
  ForwardAgent no
  Compression no
  ServerAliveInterval 0
  ServerAliveCountMax 3
  HashKnownHosts no
  UserKnownHostsFile ~/.ssh/known_hosts
  ControlMaster no
  ControlPath ~/.ssh/master-%r@%n:%p
  ControlPersist no
  IdentityFile ~/.ssh/id_main
  User rolv
